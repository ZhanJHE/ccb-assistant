venv/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# The user's literature workspace. Everything in it — corpus, ledger, raw response
# snapshots, extracted full text, PDFs — is produced by *using* the tool, and data
# produced by using the tool is local data, not source. Git tracks development
# artefacts only: code, tests, dev docs, the skill.
#
# The library lives inside the clone on purpose (see `default_library_root`), so the
# user's papers sit in the directory they cloned rather than in whatever directory
# the caller happened to be in.
#
# ⚠ Consequence: because this directory is ignored *wholesale*, `git clean -Xdf`
#   deletes the entire corpus. Back up by copying the directory, not through Git.
papers/

# Scratch directories used while developing parsers
.probe/
.research/
*.sample

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
